{
  "info": {
    "name": "LankaTools - Full API Collection",
    "description": "Complete Postman collection for the LankaTools DEA Project, covering Auth, Tools, Bookings, Admin, and File Upload endpoints. Prepared by Person 6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Auth (Person 1)",
      "item": [
        {
          "name": "Register - Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": "Test Customer"
                },
                {
                  "key": "email",
                  "value": "testcustomer999@gmail.com"
                },
                {
                  "key": "password",
                  "value": "password123"
                },
                {
                  "key": "role",
                  "value": "CUSTOMER"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Register - Shop Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": "Dinesh Perera"
                },
                {
                  "key": "email",
                  "value": "dinesh@shop.com"
                },
                {
                  "key": "password",
                  "value": "password123"
                },
                {
                  "key": "role",
                  "value": "SHOP_OWNER"
                },
                {
                  "key": "shopName",
                  "value": "Dinesh Power Tools"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Register - Validation Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": ""
                },
                {
                  "key": "email",
                  "value": "abc#"
                },
                {
                  "key": "password",
                  "value": "123"
                },
                {
                  "key": "role",
                  "value": "CUSTOMER"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Expects 302 redirect to /register?error due to invalid email/short password"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "nimal@gmail.com"
                },
                {
                  "key": "password",
                  "value": "password123"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Expects 302 redirect to /customer/dashboard with JSESSIONID cookie set"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Expects 302 redirect to /login?logout=true and clears JSESSIONID"
          }
        }
      ]
    },
    {
      "name": "Tools (Person 2)",
      "item": [
        {
          "name": "Get All Tools",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tools?page=0&size=10&sort=dailyRate,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "dailyRate,asc"
                }
              ]
            }
          }
        },
        {
          "name": "Search Tools By Name/Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tools?query=drill&category=Drilling",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "drill"
                },
                {
                  "key": "category",
                  "value": "Drilling"
                }
              ]
            }
          }
        },
        {
          "name": "Get Tool By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tools/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "1"
              ]
            }
          }
        },
        {
          "name": "Add Tool",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hammer\",\n  \"description\": \"Steel hammer\",\n  \"category\": \"TOOLS\",\n  \"dailyRate\": 200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tools/save",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "save"
              ]
            },
            "description": "Verified: actual URL is /api/tools/save (not /api/tools as originally specced). Returns 201 Created."
          }
        },
        {
          "name": "Edit Tool",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dailyRate\": 950\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tools/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete Tool",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tools/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "1"
              ]
            }
          }
        },
        {
          "name": "Upload Tool Image",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/tools/upload-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "upload-image"
              ]
            }
          }
        },
        {
          "name": "My Tools (Shop Owner)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tools/my",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tools",
                "my"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings (Person 3)",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toolId\": 1,\n  \"startDate\": \"2026-07-05\",\n  \"endDate\": \"2026-07-07\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "Get My Bookings (Customer)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/my",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "my"
              ]
            }
          }
        },
        {
          "name": "Get Owner Bookings (Shop Owner)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "owner"
              ]
            }
          }
        },
        {
          "name": "Confirm Booking",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/1/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "1",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/1/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "1",
                "reject"
              ]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/1/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "1",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Mark Returned",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/1/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "1",
                "return"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin (Person 4)",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            },
            "description": "Returns the admin/dashboard Thymeleaf view (HTML, not JSON) with totalUsers, totalTools, totalBookings, pendingApprovals in the model."
          }
        },
        {
          "name": "List Users (filter by role)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?role=CUSTOMER",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "CUSTOMER"
                }
              ]
            },
            "description": "Alias: /admin/manage-users. Returns HTML view. Omit 'role' query param to list all users."
          }
        },
        {
          "name": "Suspend / Reactivate User",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "1",
                "suspend"
              ]
            },
            "description": "Toggles suspension for user id 1. Redirects to /admin/manage-users with a flash message."
          }
        },
        {
          "name": "Approve Shop Owner",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/approve-owner",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "1",
                "approve-owner"
              ]
            },
            "description": "Approves a pending shop owner account. Redirects to /admin/manage-users."
          }
        },
        {
          "name": "Tools Moderation List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/tools-moderation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "tools-moderation"
              ]
            },
            "description": "Aliases: /admin/tools, /admin/manage-tools. Returns HTML view listing all tools with their status."
          }
        },
        {
          "name": "Update Tool Status (Approve/Reject)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/tools/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "tools",
                "1",
                "status"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "APPROVED"
                }
              ]
            },
            "description": "Form param 'status' (e.g. APPROVED / REJECTED). Redirects to /admin/manage-tools with a flash message."
          }
        },
        {
          "name": "All Bookings (platform-wide)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/bookings?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bookings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            },
            "description": "Returns HTML view. 'status' query param is optional and used to pre-select a filter in the view."
          }
        },
        {
          "name": "Registered Shops List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/shops-list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "shops-list"
              ]
            },
            "description": "Returns HTML view of registered shop owners."
          }
        },
        {
          "name": "Shop Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/shop-detail?id=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "shop-detail"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "2"
                }
              ]
            },
            "description": "Returns HTML view for a single shop owner's detail page."
          }
        },
        {
          "name": "Export Bookings CSV",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/export/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "export",
                "bookings"
              ]
            },
            "description": "Real REST endpoint (ExportController, admin-only via @PreAuthorize). Downloads bookings-export.csv. This is the one genuine JSON/REST-style admin endpoint currently in the codebase."
          }
        }
      ],
      "description": "NOTE: Most admin endpoints are server-rendered Thymeleaf views under /admin/**, not a JSON REST API under /api/admin/** (an earlier AdminApiController was removed from the project). Expect HTML or a 302 redirect back from these, except for the CSV export endpoint which is a real REST call."
    },
    {
      "name": "Notifications (Person 5)",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          }
        },
        {
          "name": "Owner Approve Booking",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/owner/bookings/approve/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "bookings",
                "approve",
                "1"
              ]
            },
            "description": "Alternate booking approval route used in the notifications/owner flow"
          }
        }
      ]
    }
  ]
}
